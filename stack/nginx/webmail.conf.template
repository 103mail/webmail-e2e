# One template for every Domain. The nginx image substitutes ${WEBMAIL_DOMAIN}
# from the environment at start-up, so the only thing that distinguishes the
# web containers is that variable.
#
# Everything a Domain exposes lives under the one hostname webmail.{domain}:
# the peer descriptor and the REST API. The suite drives the API only, so
# there is no /config.json, no chat WebSocket and no plain HTTP listener.

server {
    listen 443 ssl;
    http2 on;
    server_name webmail.${WEBMAIL_DOMAIN};

    ssl_certificate     /etc/nginx/certs/webmail.${WEBMAIL_DOMAIN}.crt;
    ssl_certificate_key /etc/nginx/certs/webmail.${WEBMAIL_DOMAIN}.key;
    ssl_protocols       TLSv1.2 TLSv1.3;

    root /usr/share/nginx/html;
    client_max_body_size 48m;   # matches WEBMAIL_MAX_BODY_BYTES

    # Docker's embedded DNS, with upstreams held in variables. nginx resolves a
    # literal proxy_pass host once at start-up, so restarting the API container
    # would otherwise 502 until nginx itself restarted.
    resolver 127.0.0.11 valid=10s ipv6=off;

    # Peer descriptor, RFC 4.1. Proxied rather than served from a file, so it
    # is rendered from the private key the server actually signs with and the
    # two cannot drift apart. MUST NOT redirect, so no try_files here.
    location = /.well-known/webmail-federation {
        set $wellknown_upstream http://api:8080;
        proxy_pass $wellknown_upstream$request_uri;
        proxy_set_header Host $host;
    }

    # Federation inbound goes through the fault proxy, which passes it to this
    # Domain's API unless a story has armed a fault. The body limit is the
    # API's to enforce: it answers 413 too_large, which a peer can read, where
    # nginx would answer with a page.
    location = /api/v1/federation/inbound {
        set $faults_upstream http://faults:8080;
        proxy_pass $faults_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host            $host;
        proxy_set_header X-Faults-Domain ${WEBMAIL_DOMAIN};
        proxy_set_header X-Real-IP       $remote_addr;
        proxy_read_timeout 60s;
    }

    location /api/ {
        set $api_upstream http://api:8080;
        proxy_pass $api_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    location = /health {
        set $health_upstream http://api:8080;
        proxy_pass $health_upstream/health;
    }
}
